{
  "name": "klorn",
  "license": "AGPL-3.0-only",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ],
    "overrides": {
      "@grpc/grpc-js": ">=1.14.5",
      "@opentelemetry/core": ">=2.8.0",
      "axios": ">=1.20.0",
      "body-parser": ">=2.4.0 <3",
      "brace-expansion@^2.0.0": ">=2.1.7 <3",
      "brace-expansion@^5.0.0": ">=5.0.9",
      "deepmerge-ts": ">=8.0.0",
      "defu": ">=6.1.5",
      "effect": ">=3.20.0",
      "fast-uri": ">=4.2.3 <5",
      "fast-xml-parser": ">=5.10.1",
      "find-my-way": ">=9.7.0",
      "follow-redirects": ">=1.16.2 <2",
      "form-data": ">=4.0.6",
      "gaxios@^7.0.0": ">=7.3.1 <8",
      "google-gax@^5.0.0>rimraf": "-",
      "hono": ">=4.13.7 <5",
      "@hono/node-server": ">=2.1.3 <3",
      "@fastify/busboy": ">=3.2.2 <4",
      "ip-address": ">=10.7.4",
      "nanoid": ">=3.3.17",
      "nodemailer": ">=10.1.4 <11",
      "postcss": ">=8.5.23",
      "protobufjs": ">=7.6.5",
      "proxy-addr": ">=2.0.8 <3",
      "qs": ">=6.16.1 <7",
      "sharp": ">=0.35.5",
      "source-map-js": ">=1.2.2 <2",
      "uuid": ">=11.1.1",
      "zod": ">=4.6.6 <5"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @klorn/api --filter @klorn/web --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  }
}
