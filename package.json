{
  "name": "klorn",
  "license": "AGPL-3.0-only",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ],
    "overrides": {
      "@grpc/grpc-js": ">=1.14.5",
      "@opentelemetry/core": ">=2.8.0",
      "axios": ">=1.20.0",
      "brace-expansion@^2.0.0": ">=2.1.7 <3",
      "brace-expansion@^5.0.0": ">=5.0.9",
      "deepmerge-ts": ">=8.0.0",
      "defu": ">=6.1.5",
      "effect": ">=3.20.0",
      "fast-uri": ">=4.1.5",
      "fast-xml-parser": ">=5.10.1",
      "find-my-way": ">=9.7.0",
      "form-data": ">=4.0.6",
      "ip-address": ">=10.7.1",
      "nanoid": ">=3.3.17",
      "nodemailer": ">=10.0.13",
      "postcss": ">=8.5.23",
      "protobufjs": ">=7.6.5",
      "qs": ">=6.16.0",
      "sharp": ">=0.35.0",
      "uuid": ">=11.1.1"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @klorn/api --filter @klorn/web --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  }
}
