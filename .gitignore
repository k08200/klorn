# Static export for Cloudflare Pages (pnpm --filter @klorn/web build:static)
packages/web/out/

# Local Claude Code state (session settings/worktrees — never commit)
.claude/
.gstack/

# Internal strategy / council discussion notes — contain prioritization
# notes and personal email addresses. Never commit to this public repo.
.discussions/

# PoC measurement artifacts — contain real personal email addresses and
# snippet text from the founder's inbox. Never commit to this public repo.
poc-*.json
poc-demo-mock-server.cjs
.record-scenes*.mjs
packages/api/scripts/poc-label-interactive.ts
packages/api/scripts/diagnose-calendar-times.ts

# threshold-sweep.ts feature cache (extracted scores, regenerated on demand)
packages/api/eval/.feature-cache.json

# Database dumps — these are real user data. A pg_dump of production is
# ~82MB of mail, tokens and personal information; one `git add -A` on a
# public repo publishes it. Backups belong outside the working tree.
*.dump
*.sql.gz
*-backup.sql

# IP24 report output (packages/api ip24-report --out): per-user numbers, never commit
ip24*.json
