{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klorn",
  "mainBinaryName": "Klorn",
  "version": "0.2.0",
  "identifier": "ai.klorn.desktop.win",
  "build": {
    "frontendDist": "https://app.klorn.ai"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Klorn",
        "url": "https://app.klorn.ai/login",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "backgroundColor": "#FFFFFF"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
