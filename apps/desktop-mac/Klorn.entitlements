<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime resource access for EventKit (step C6: device calendars).
       Without it a Developer-ID-signed, notarized build is refused calendar
       access silently, however the user answers. -->
  <key>com.apple.security.personal-information.calendars</key><true/>
</dict>
</plist>
