{
  "name": "@klorn/api",
  "version": "0.3.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Klorn API server",
  "main": "dist/index.js",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 tsc",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:prod": "sh scripts/start.sh",
    "lint": "biome check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "backfill:from-address": "tsx scripts/backfill-from-address.ts",
    "calibration": "tsx scripts/calibration.ts",
    "decision-metrics": "tsx scripts/decision-metrics.ts",
    "throughput": "tsx scripts/throughput.ts",
    "prune:push-logs": "tsx scripts/prune-push-logs.ts",
    "cleanup:commitment-noise": "tsx scripts/cleanup-commitment-noise.ts",
    "eval:judge": "tsx scripts/poc-accuracy.ts --in=eval/judge-eval-set.json --concurrency=1 --delay=4500",
    "eval:real": "tsx scripts/poc-accuracy.ts --in=eval/real-eval-set.json --concurrency=2 --delay=500",
    "eval:judge:body": "tsx scripts/poc-accuracy.ts --in=eval/judge-body-eval-set.json --compare-body --concurrency=1 --delay=4500",
    "eval:judge:context": "tsx scripts/poc-accuracy.ts --in=eval/judge-context-eval-set.json --compare-context --concurrency=1 --delay=4500"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.2.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.8.2",
    "@sentry/node": "^10.71.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.1",
    "firebase-admin": "^14.3.0",
    "googleapis": "^171.4.0",
    "imapflow": "^1.7.6",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.29.0",
    "resend": "^6.24.0",
    "sanitize-html": "^2.17.7",
    "stripe": "^18.1.0",
    "twilio": "^6.1.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@klorn/contract": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.0",
    "@types/sanitize-html": "^2.16.1",
    "prisma": "^6.8.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
