{
  "name": "@klorn/api",
  "version": "0.4.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Klorn API server",
  "main": "dist/index.js",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 tsc",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:prod": "sh scripts/start.sh",
    "lint": "biome check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "backfill:from-address": "tsx scripts/backfill-from-address.ts",
    "calibration": "tsx scripts/calibration.ts",
    "decision-metrics": "tsx scripts/decision-metrics.ts",
    "replay:policy": "tsx scripts/replay-policy.ts",
    "v3-shadow-report": "tsx scripts/v3-shadow-report.ts",
    "cost-report": "tsx scripts/llm-cost-report.ts",
    "eval:facts": "tsx scripts/v3-fact-eval.ts",
    "label:own-mail": "tsx scripts/v3-label-own-mail.ts",
    "throughput": "tsx scripts/throughput.ts",
    "lane-quality": "tsx scripts/lane-quality.ts",
    "prune:push-logs": "tsx scripts/prune-push-logs.ts",
    "cleanup:commitment-noise": "tsx scripts/cleanup-commitment-noise.ts",
    "eval:judge": "tsx scripts/poc-accuracy.ts --in=eval/judge-eval-set.json --concurrency=1 --delay=4500",
    "eval:real": "tsx scripts/poc-accuracy.ts --in=eval/real-eval-set.json --concurrency=2 --delay=500",
    "eval:judge:body": "tsx scripts/poc-accuracy.ts --in=eval/judge-body-eval-set.json --compare-body --concurrency=1 --delay=4500",
    "eval:judge:context": "tsx scripts/poc-accuracy.ts --in=eval/judge-context-eval-set.json --compare-context --concurrency=1 --delay=4500"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^11.11.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "aws4fetch": "1.0.20",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "firebase-admin": "^14.5.0",
    "googleapis": "^171.4.0",
    "ical.js": "2.2.1",
    "imapflow": "^1.7.0",
    "jose": "^6.2.15",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.4.0",
    "openai": "^7.53.0",
    "postcss": "8.5.32",
    "resend": "^6.37.0",
    "sanitize-html": "^2.18.0",
    "stripe": "^23.1.0",
    "twilio": "^6.3.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@klorn/contract": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.0",
    "@types/sanitize-html": "^2.16.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
