# Database
# Default matches the bundled docker-compose.yml so `docker compose up -d
# postgres` works out of the box. If you want to run a Postgres you
# already own, override accordingly.
#
# For Neon (serverless Postgres) in production, append these query params
# to survive cold-starts and avoid prepared-statement issues with PgBouncer:
#   ?pgbouncer=true&connect_timeout=15&connection_limit=1
# Example:
#   DATABASE_URL="postgresql://user:pw@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=1"
DATABASE_URL="postgresql://klorn:klorn-local-dev@localhost:5432/klorn"

# Keep off on Neon/Render free tiers; true makes the DB effectively always-on.
DB_HEARTBEAT_ENABLED=false

# Server
PORT=8000
# Comma-separated founder/operator emails that always get admin access.
ADMIN_EMAILS=""

# Web app URL (for OAuth redirects)
WEB_URL="http://localhost:8001"

# Transactional email (Resend) — verification, password reset, beta invites,
# and the founder welcome email. Without RESEND_API_KEY every sender is a
# graceful no-op (links are logged, nothing is sent), so local dev needs none.
# RESEND_API_KEY=""
# FROM_EMAIL="Klorn <onboarding@yourdomain.com>"   # must be a Resend-verified sender
#
# Founder welcome email — auto-sent once per user on first Google sign-in or on
# email verification. All optional:
#   FOUNDER_NAME    — sender display name + signoff (empty → neutral team voice)
#   FOUNDER_TITLE   — line under the signoff (default "Founder")
#   FOUNDER_REPLY_TO— where "just hit reply" lands (default: first ADMIN_EMAILS)
#   WELCOME_FROM_EMAIL — override the From for this one email (default FROM_EMAIL)
#   COMMUNITY_URL   — Slack/Discord invite; the invite line is omitted if unset
# FOUNDER_NAME=""
# FOUNDER_TITLE="Founder"
# FOUNDER_REPLY_TO=""
# WELCOME_FROM_EMAIL=""
# COMMUNITY_URL=""

# Klorn mailbox, inbound (step E1b of docs/providers/unified-platform-plan.md):
# Resend Inbound's email.received webhook at POST /api/mailbox/inbound/resend.
# OFF by default; while off the route answers the default 404. With the flag on
# and the secret, the inbound key or the domain unset, it answers 503 (Resend
# retries for about 28 h) and logs which variable is missing. All read per request.
# KLORN_MAILBOX_ENABLED also takes `cohort` (see ROLLOUT_COHORT_USER_IDS): the
# inbound route serves every recipient either way, since it is not per user; the
# address claim (E3) is what will honour the cohort.
#   RESEND_INBOUND_WEBHOOK_SECRET — the receiving webhook's signing secret: whsec_
#                                   and a base64 key of at least 16 bytes (a shorter
#                                   or malformed one counts as unset)
#   RESEND_INBOUND_API_KEY        — a FULL-ACCESS Resend key, to read received mail
#                                   and send the system-mail notices; kept apart from
#                                   RESEND_API_KEY so that one can stay sending-only.
#                                   Recommended (founder action): create it in a
#                                   SEPARATE Resend team/account that receives the
#                                   mailbox domain, so a leaked inbound key cannot send
#                                   as the transactional domain. That team must also
#                                   verify the domain for sending: the notices come
#                                   from postmaster@<domain> / abuse@<domain>
#   KLORN_MAILBOX_DOMAIN          — the address domain, e.g. klorn.ai; no default (L19)
#   KLORN_MAILBOX_FORWARD_TO      — the support inbox told of mail to postmaster@ and
#                                   abuse@ (L18): a notice naming the Resend email id,
#                                   never the mail itself (read it in Resend, Receiving).
#                                   One plain address outside the domain, at most 20
#                                   notices an hour. Unset or unusable (also logged as
#                                   an error), that mail is dropped and counted
# KLORN_MAILBOX_ENABLED=false
# RESEND_INBOUND_WEBHOOK_SECRET=""
# RESEND_INBOUND_API_KEY=""
# KLORN_MAILBOX_DOMAIN=""
# KLORN_MAILBOX_FORWARD_TO=""

# LLM (OpenRouter — primary provider)
OPENROUTER_API_KEY=""
# Default free model for beta cost control.
# CHAT_MODEL="google/gemma-4-31b-it:free"
# AGENT_MODEL="google/gemma-4-31b-it:free"
# Tier judge + reply drafting default to a reliable (paid) model — a :free
# daily-quota lockout otherwise breaks PUSH classification and "Draft reply".
# Point these at a :free or local model if you have no paid credit.
# JUDGE_MODEL="google/gemini-2.5-flash"
# DRAFT_MODEL="google/gemini-2.5-flash"
# Fallback free model when OpenRouter credits are exhausted (402)
FALLBACK_MODEL="google/gemma-4-31b-it:free"

# Cents of the per-user daily cap that ONLY the firewall judge may spend.
# Chat, agent, briefing and summarize stop at (cap - reserve). 0 = OFF.
# Each classification pre-bills ~0.19¢, so 25 buys ~135 a day — size it
# against the mailbox. On the free tier the reserve is clamped to half the
# cap, so 25 against a 10¢ cap leaves ordinary calls 5¢.
# JUDGE_BUDGET_RESERVE_CENTS="25"
# Privacy kill switch (hosted prod sets true): disables EVERY :free-model
# fallback — :free OpenRouter endpoints route to hosts that may train on
# request data. On 402 the chain fails over to the next provider (Gemini)
# instead. Self-host default (unset) keeps the $0 degradation net.
# DISABLE_FREE_MODEL_FALLBACK=true

# Gemini (Google AI Studio) — secondary provider used when OpenRouter
# returns 403 "Key limit exceeded (weekly limit)". Completely free quota,
# independent of OpenRouter. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# GEMINI_FALLBACK_MODEL="gemini-2.5-flash"

# Anthropic (Claude API, native SDK). OFF until the key is set. With only the
# key, Anthropic is a failover lane at the END of the env chain; put it first
# with LLM_PROVIDER_ORDER. Pins that are not Claude ids (e.g. JUDGE_MODEL=
# "google/gemini-2.5-flash") are served by ANTHROPIC_MODEL; Claude pins
# (claude-haiku-5-5, or OpenRouter-style anthropic/claude-haiku-5.5) are kept.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-haiku-5-5"
# Only for a personal / service-account key NOT scoped to a workspace (Console
# → Workspaces → ID column). A workspace-scoped key needs nothing here.
# ANTHROPIC_WORKSPACE_ID=""
# ANTHROPIC_PROMPT_CACHE=true          # system-prompt cache breakpoint; false = off
# ANTHROPIC_CACHE_TTL="5m"             # "5m" (1.25x write) | "1h" (2x write)
# ANTHROPIC_EFFORT=""                  # low|medium|high|xhigh|max; unset = model default

# Order of the server-key providers (openrouter, gemini, anthropic). Listed
# names go first; configured providers you don't list follow in the default
# order, so a typo can reorder the chain but never empty it. BYOK user keys
# always lead; the local provider keeps OPENAI_COMPAT_PRIORITY.
# LLM_PROVIDER_ORDER="anthropic,gemini"

# Local LLM (any OpenAI-compatible endpoint: Ollama, LM Studio, vLLM,
# llama.cpp server). When set, classification runs against it FIRST and
# your email content never leaves your machine; cloud providers above (if
# configured) act as failover only. Set OPENAI_COMPAT_PRIORITY=last to use
# the local endpoint as the fallback instead.
# Ollama example:  OPENAI_COMPAT_BASE_URL="http://localhost:11434/v1"
OPENAI_COMPAT_BASE_URL=""
# OPENAI_COMPAT_MODEL="qwen3:8b"
# OPENAI_COMPAT_API_KEY=""           # most local servers ignore auth
# OPENAI_COMPAT_PRIORITY="first"     # "first" (default) | "last"
# OPENAI_COMPAT_SUPPORTS_TOOLS=false # opt in only if your model handles tools

# File conversion
# Results are persisted on disk for 7 days by default.
# EVE_CONVERSION_STORAGE_DIR="./data/file-conversions"
# EVE_CONVERSION_RESULT_TTL_MS=604800000
# EVE_CONVERTER_TIMEOUT_MS=60000
#
# Layout-preserving Office/PDF export. If unset, EVE auto-detects soffice/libreoffice
# from PATH and common macOS install paths.
# EVE_LIBREOFFICE_BIN="/Applications/LibreOffice.app/Contents/MacOS/soffice"
#
# Raster image re-encoding. If unset, EVE auto-detects ImageMagick `magick`.
# EVE_IMAGE_CONVERTER_BIN="/opt/homebrew/bin/magick"
# EVE_IMAGE_CONVERTER_ARGS="[\"{input}\",\"{output}\"]"
#
# CAD conversion. DWG usually requires a commercial/server CAD converter.
# DXF can also auto-detect pstoedit when installed.
# DWG can also be produced as PDF→DXF→DWG when ODA File Converter is installed
# or when EVE_DXF_TO_DWG_BIN is configured.
# EVE_PDF_TO_DWG_BIN="/path/to/pdf-to-dwg"
# EVE_PDF_TO_DWG_ARGS="[\"{input}\",\"{output}\"]"
# EVE_PDF_TO_DXF_BIN="/path/to/pdf-to-dxf"
# EVE_PDF_TO_DXF_ARGS="[\"{input}\",\"{output}\"]"
# EVE_DXF_TO_DWG_BIN="/Applications/ODAFileConverter.app/Contents/MacOS/ODAFileConverter"
# EVE_DXF_TO_DWG_ARGS="[\"{input}\",\"{output}\"]"

# Google OAuth (Gmail + Calendar)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paddle (web payments — merchant of record, the decided web provider).
# API key: Paddle → Developer tools → Authentication. Webhook secret: the
# notification-endpoint secret for POST /api/webhook/paddle. Price: the
# $29.99/mo PRO price (pri_…) with the 7-day trial configured on it.
# PADDLE_ENV=sandbox targets the sandbox account; unset = live.
# PADDLE_API_KEY=""
# PADDLE_WEBHOOK_SECRET=""
# PADDLE_PRO_PRICE_ID=""
# PADDLE_ENV="sandbox"

# Stripe (Billing — alternative web provider; requires a business entity)
STRIPE_SECRET_KEY=""

# Paywall master switch. Unset/false = every gated feature is free and the
# entitlement guards are no-ops (safe default for self-host and pre-launch).
# Flip to "true" at launch — see docs/launch/paywall-flip-runbook.md.
# PAYWALL_ENABLED=false

# RevenueCat (in-app purchases — iOS/Android). Shared secret you set as the
# Authorization header on the RevenueCat webhook (Project → Integrations →
# Webhooks). The webhook POSTs to /api/webhook/revenuecat and syncs user.plan.
# The CLIENT SDK keys are separate and public — set them in the WEB app env
# (Vercel) as NEXT_PUBLIC_REVENUECAT_IOS_KEY / NEXT_PUBLIC_REVENUECAT_ANDROID_KEY.
# REVENUECAT_WEBHOOK_AUTH=""

# Telegram notifications (Optional — see README "Telegram notifications")
# BYO bot via @BotFather. PUSH-tier interrupts are mirrored to the linked
# chat; works without VAPID keys for web-push-free self-hosts.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_BOT_USERNAME=""
# Required to enable the webhook endpoint; pass the same value as
# secret_token to setWebhook. Generate: openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=""

# Native push / FCM (Optional — required for the Capacitor mobile shell,
# apps/mobile, to deliver push to Android). The full Firebase service-account
# JSON as a single-line string:
#   Firebase console → Project settings → Service accounts → Generate new
#   private key. Absent → Android native push is skipped (logged), like VAPID.
# FIREBASE_SERVICE_ACCOUNT=""

# Native iOS push / APNs (Optional — required for iOS push in the Capacitor
# shell). iOS device tokens are raw APNs tokens (not FCM), so they go straight
# to Apple. Create an APNs auth key (.p8) in the Apple Developer portal.
# APNS_KEY_P8 holds the .p8 contents (newlines as literal \n are accepted).
# Absent → iOS push is skipped (logged), like missing FCM/VAPID.
# APNS_KEY_P8=""
# APNS_KEY_ID=""
# APNS_TEAM_ID=""
# APNS_BUNDLE_ID="ai.klorn.app"
# APNS_PRODUCTION="false"   # "true" for TestFlight/App Store builds; sandbox otherwise

# Outlook inbox linking via Microsoft Graph OAuth (Phase 3, multi-provider
# plan). OFF by default; while unset/false every /api/auth/outlook route 404s.
# MS_CLIENT_ID/MS_CLIENT_SECRET come from the Azure app registration
# (supported account types: personal + work/school). MS_TENANT defaults to
# "common"; MS_REDIRECT_URI defaults to the localhost dev callback.
# OUTLOOK_INBOX_ENABLED=false
# Outlook calendar, read-only (step C4 of docs/providers/unified-platform-plan.md).
# OFF by default and it ALSO needs OUTLOOK_INBOX_ENABLED. While either is off the
# /api/auth/outlook/link-calendar and /linked-calendars routes 404 and Outlook
# calendar rows are hidden from every reader. Adds Calendars.Read to the Azure
# app (FA-9); the inbox link's scopes are unchanged. Events sync only with
# LINKED_CALENDAR_SYNC_ENABLED on too.
# OUTLOOK_CALENDAR_ENABLED=false
# MS_CLIENT_ID=""
# MS_CLIENT_SECRET=""
# MS_REDIRECT_URI="http://localhost:3001/api/auth/outlook/callback"
# MS_TENANT="common"

# iCloud Mail connect + sync (IMAP with an Apple app-specific password).
# Phase 2 of the multi-provider plan — OFF by default; while unset/false the
# /api/icloud-imap routes 404 and the IMAP poll never selects ICLOUD rows.
# ICLOUD_INBOX_ENABLED=false

# IMAP flag actions (read, unread, star) for Naver and iCloud — step B1 of
# docs/providers/unified-platform-plan.md. OFF by default. While unset/false,
# NAVER and ICLOUD actions answer 501 exactly as before; generic IMAP stays
# unsupported either way. Read at request time — no redeploy needed to flip it.
# IMAP_ACTIONS_ENABLED=false

# Send, reply and drafts for Naver and iCloud over SMTP + IMAP — step B3 of
# docs/providers/unified-platform-plan.md. OFF by default and independent of
# IMAP_ACTIONS_ENABLED. While unset/false, NAVER and ICLOUD send and draft answer
# 501 exactly as before; iCloud additionally needs ICLOUD_INBOX_ENABLED. Read at
# request time — no redeploy needed to flip it.
# IMAP_SEND_ENABLED=false

# Linked Google calendar sync — step C2 of docs/providers/unified-platform-plan.md.
# OFF by default. While unset/false the scheduler syncs only the primary
# calendar, exactly as before (no linked-account lookup, no extra Google call).
# When on, every linked GOOGLE calendar account is also synced into CalendarEvent
# rows each cycle (same 30-day window and 100-event cap as the primary sync).
# Read at request time — no redeploy needed to flip it. Turning it off stops the
# syncing; rows already written stay until their account is unlinked.
# LINKED_CALENDAR_SYNC_ENABLED=false

# Remove events deleted or cancelled in Google on the next calendar sync — step
# C2b of docs/providers/unified-platform-plan.md. OFF by default. While unset/false
# every calendar sync (scheduler, login init-sync, POST /api/calendar/sync, linked
# accounts) makes exactly the Google calls it always did and removes no row. When
# on, each sync also runs one extra bounded events.list (showDeleted + updatedMin,
# paged, 10 s timeout) and deletes the rows of the events Google reports cancelled,
# resolving their attention items. Read at sync time — no redeploy needed to flip
# it. Flip it only after a check against a real Google calendar.
# CALENDAR_CANCELLATION_SYNC_ENABLED=false

# Google invitations the user declined. OFF by default. While unset/false a sync
# writes a row for a declined invitation like any event. When on, a sync writes no
# row for it and removes the row an earlier sync wrote, resolving its attention
# items. Google only (the user's own attendee entry), rows only (live Google reads
# still return them). Read at sync time.
# CALENDAR_HIDE_DECLINED_ENABLED=false

# iCloud and Naver calendars over CalDAV, read-only — step C3 of
# docs/providers/unified-platform-plan.md. OFF by default. While unset/false every
# /api/caldav-calendar route 404s, ICLOUD and NAVER calendar rows are hidden from
# every reader, and the sync opens no CalDAV connection. The server URLs are pinned
# in code (caldav.icloud.com, caldav.calendar.naver.com); there is nothing else to
# configure. Events sync only with LINKED_CALENDAR_SYNC_ENABLED on too. When on, a
# complete window listing also removes the rows of events deleted upstream.
# Read at request time — no redeploy needed to flip it.
# CALDAV_CALENDAR_ENABLED=false

# Device calendars uploaded by the desktop app (macOS EventKit), read-only — step
# C6 of docs/providers/unified-platform-plan.md. OFF by default. While unset/false
# every /api/device-calendar route 404s (the Mac app then hides its "Upload device
# calendars" setting), no snapshot is stored, and DEVICE calendar rows are hidden
# from every reader. A device uploads only the calendars its user turned on, one by
# one (decision P4). Read at request time — no redeploy needed to flip it.
# DEVICE_CALENDAR_ENABLED=false

# Subscriptions — the per-sender bulk unsubscriber under Mail. OFF by default.
# While unset/false GET /api/email/subscriptions and POST
# /api/email/subscriptions/unsubscribe 404 and the web hides the entry point.
# User-initiated only (never scheduled); independent of AUTO_UNSUBSCRIBE_ENABLED.
# Read at request time — no redeploy needed to flip it.
# BULK_UNSUBSCRIBE_ENABLED=false

# The drive: a metadata index of the user's files across sources — step D2 of
# docs/providers/unified-platform-plan.md. OFF by default. While unset/false every
# /api/drive route 404s and every reader hides every DriveFile row. On, a file is
# listed only while its source's own flag is on too: the Klorn drive (D3) and
# Google Drive (D5) below; OneDrive (D6) is not built yet. Read at request time —
# no redeploy needed to flip it.
# DRIVE_ENABLED=false
# Rollout cohort (decision L23: founder account, then cohort, then everyone).
# DRIVE_ENABLED, KLORN_DRIVE_ENABLED, GOOGLE_DRIVE_ENABLED and
# DRIVE_SUMMARIES_ENABLED also take the value `cohort`: the feature is then open
# only to the user ids below (comma or whitespace separated), and everyone else
# gets the same 404 as the flag off. An empty list lets no one in. Read per
# request. OBJECT_STORAGE_ENABLED has no cohort: it is infrastructure.
# ROLLOUT_COHORT_USER_IDS=""

# The Klorn drive — step D3 of docs/providers/unified-platform-plan.md: upload,
# folders, download, rename/move and delete of the user's own files, stored in
# object storage. OFF by default. Live only while DRIVE_ENABLED and
# OBJECT_STORAGE_ENABLED are on too; until then its routes 404 and its files are
# hidden from the list. Turning it off hides the files and stops writes; it never
# deletes them. Before turning it on: privacy policy and terms approved (FA-5),
# the real-bucket contract run passed (FA-7), and the quota below decided (P3).
# Read at request time.
# KLORN_DRIVE_ENABLED=false
# The most bytes one user's Klorn drive may hold, as a whole number of bytes
# (10 GiB = 10737418240). REQUIRED once the drive is on: unset or blank refuses
# every upload (503 quota-not-configured) and boot warns by this variable's name;
# a value that is not a whole number refuses every upload too (503). One number
# for everyone until per-plan limits exist (P3, decided at flip time). Read at
# request time.
# KLORN_DRIVE_QUOTA_BYTES=

# Drive file summaries and summary search — step D4 of
# docs/providers/unified-platform-plan.md. OFF by default. Acts only while
# DRIVE_ENABLED is on too, and only on files whose source is visible (a Klorn
# file: KLORN_DRIVE_ENABLED and OBJECT_STORAGE_ENABLED). While unset/false: no
# upload queues a summary, the 5-minute summary job reads nothing,
# POST /api/drive/files/:id/summarize 404s, file metadata carries no summary and
# the search matches names only. On: each summary is one model call through the
# shared LLM layer (per-user daily cost cap, global ceiling, BYOK), capped at
# 50 summaries per user and 3 per file per UTC day; a cap leaves it PENDING until
# the cap lifts. Read at request and job time.
# DRIVE_SUMMARIES_ENABLED=false

# Google Drive — step D5 of docs/providers/unified-platform-plan.md (D5b: link and
# unlink a Google account for the files the user picks; D5c: the Google Picker
# and the index of picked files). OFF by default. Live only while DRIVE_ENABLED
# is on too. While unset/false: every /api/drive/google route (link, accounts,
# unlink, picker-session, picked) 404s, every GOOGLE file is hidden, and a
# link callback still in flight exchanges no code and stores nothing. On: the
# consent asks for openid, userinfo.email and drive.file only (no
# include_granted_scopes), under the same GOOGLE_CLIENT_ID and
# GOOGLE_REDIRECT_URI as sign-in; a user links at most 5 accounts; unlinking
# removes the account and its files from Klorn and does not revoke the grant at
# Google. Do NOT turn it on until the plan's "Before the flip" is done: the
# current Google verification has passed and drive.file is added to the consent
# screen and approved (FA-10), on a production project with the Drive and Picker
# APIs enabled. Read at request time.
# GOOGLE_DRIVE_ENABLED=false
# The Google Picker (D5c). Both are PUBLIC by design and handed to the browser by
# POST /api/drive/google/accounts/:id/picker-session (with a drive.file token
# minted on click), so a web bundle built without the Picker holds neither.
# Either unset: that route answers 503 picker-not-configured.
#   GOOGLE_PICKER_API_KEY: a browser API key. In the Cloud console, restrict it
#     to the web origin's HTTP referrers (https://app.klorn.ai/*) and to the
#     Google Picker API only. It is not GOOGLE_CLIENT_SECRET and reads no
#     user's data by itself.
#   GOOGLE_CLOUD_PROJECT_NUMBER: the project NUMBER (not its id) of
#     GOOGLE_CLIENT_ID's project, the Picker's setAppId, which ties the picked
#     files to this project's drive.file grant.
# The web must also be built with NEXT_PUBLIC_GOOGLE_DRIVE_PICKER=on, which
# compiles the Picker in and lets the CSP load it (packages/web/next.config.ts).
# GOOGLE_PICKER_API_KEY=
# GOOGLE_CLOUD_PROJECT_NUMBER=

# Archive, trash, and their undo for Naver and iCloud over IMAP MOVE — step B2 of
# docs/providers/unified-platform-plan.md. OFF by default and independent of
# IMAP_ACTIONS_ENABLED and IMAP_SEND_ENABLED. While unset/false, NAVER and ICLOUD
# archive, trash and their undo answer 501 exactly as before; iCloud additionally
# needs ICLOUD_INBOX_ENABLED. Read at request time — no redeploy needed to flip it.
# IMAP_MOVE_ACTIONS_ENABLED=false

# One calendar read path (step C7 of docs/providers/unified-platform-plan.md).
# OFF by default. While unset/false, list_events (chat and MCP) calls Google live
# and check_calendar_conflicts asks Google free/busy only, exactly as before. When
# on, both read the synced CalendarEvent rows (scope + dedupe, provider and
# readOnly per event) and the conflict check still asks Google free/busy too.
# Reach: it changes every caller of those two functions: the chat, the MCP
# endpoint, the autonomous agent, create_event's enforced conflict check (a
# booking can be refused on a stale row) and the reading pane's meeting context.
# Trade-off: rows are synced about every 15 minutes
# (SCHEDULER_CALENDAR_SYNC_INTERVAL_MS), so a very recent change may not show, and
# an event deleted upstream can stay in them until the sync removes it.
# Read at request time — no redeploy to flip.
# UNIFIED_CALENDAR_READ_ENABLED=false

# Generic IMAP with a user-supplied host — step B4 of
# docs/providers/unified-platform-plan.md. OFF by default and NOT to be flipped until
# the security review of its SSRF design (resolve-then-pin) has signed off and the
# real-server tests in that step's "Before the flip" list are done. While unset/false,
# every /api/generic-imap route 404s, the poll never selects IMAP rows, and a generic
# mailbox stays on the unsupported stubs whatever IMAP_ACTIONS_ENABLED and
# IMAP_MOVE_ACTIONS_ENABLED say (they must be on as well for read/star and archive/
# trash). Send never reaches a generic mailbox. Read at request time.
# GENERIC_IMAP_ENABLED=false

# MCP write tools — API key permission level (step A1 of
# docs/providers/unified-platform-plan.md). OFF by default. Gates both minting a
# read-write API key and using one: while unset/false, POST /api/keys ignores the
# permission field (every new key is read) and a stored read-write key acts as
# read at the MCP endpoint. Read at request time — no redeploy needed to flip it.
# MCP_WRITE_TOOLS_ENABLED=false

# Keyboard triage (productization plan P4). OFF by default. One flag for both
# halves: the web reads it from GET /api/auth/me (user.keyboardTriage) and turns
# on the hotkey registry, the `?` sheet and optimistic lane moves with undo; the
# API turns on the reversible lane override (undo token on the override
# response, POST /api/inbox/firewall/:id/undo, POST /api/inbox/firewall/email/:emailId).
# Read at request time — no redeploy needed to flip it.
# KEYBOARD_TRIAGE=false

# Mail v2 (productization plan P5). OFF by default. One flag for both halves:
# the web reads it from GET /api/auth/me (user.mailV2) and renders /email as the
# lane-first list; the API honours `tier` on GET /api/email and serves
# GET /api/email/lane-counts. Read at request time — no redeploy needed to flip it.
# MAIL_V2=false

# Unified home (productization plan P6/P7). OFF by default. One flag for both
# halves: the web reads it from GET /api/auth/me and the login/register
# responses (user.unifiedHome), makes Today (/today) the home and switches the
# nav to Today · Mail · Calendar · Assistant; the API serves the lane reads
# Today needs (`tier` on GET /api/email, GET /api/email/lane-counts) even while
# MAIL_V2 is off. Read at request time — no redeploy needed to flip it.
# UNIFIED_HOME=false

# Object storage (step D1 of docs/providers/unified-platform-plan.md): the
# S3-compatible bucket behind the Klorn drive, file summaries and mailbox
# attachments. OFF by default. While unset/false nothing below is read, no client
# is built and nothing connects. While on, the five variables below are required:
# they are validated at startup and on first use, a wrong one is reported by NAME
# in a [STORAGE] log line (the server keeps running; storage calls fail until it
# is fixed). Deleting an account or its data first records a pending purge of
# that user's objects (StoragePurge), then tries the bucket once; a bucket that
# is down no longer blocks the deletion, and an hourly sweep finishes the purge
# (step D3). Do not turn it back off once objects exist: the purge and the sweep
# would skip them (startup logs a [STORAGE] warning when the flag is off and the
# endpoint, bucket or keys below are still set). Read at request time.
# OBJECT_STORAGE_ENABLED=false
# Cloudflare R2: https://<account id>.r2.cloudflarestorage.com
# MinIO (development only, plain http is refused elsewhere): http://localhost:9000
# Supabase Storage: https://<project>.supabase.co/storage/v1/s3
# OBJECT_STORAGE_ENDPOINT=""
# OBJECT_STORAGE_REGION="auto"             # R2: auto
# OBJECT_STORAGE_BUCKET=""
# An API token limited to object read and write on THIS bucket.
# OBJECT_STORAGE_ACCESS_KEY_ID=""
# OBJECT_STORAGE_SECRET_ACCESS_KEY=""
# true (default): <endpoint>/<bucket>/<key>, for R2, MinIO and Supabase.
# false: <bucket>.<endpoint host>/<key>, for AWS S3.
# OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Attention aging sweep (hourly): auto-resolve firewall items acted on
# elsewhere + age out SILENT (14d) / QUEUE (30d) email items. OFF by default.
# ATTENTION_AGING_ENABLED=false

# Kill switch for the activity-driven mail pull fired by GET /api/inbox/firewall
# (debounced 60s/user). Ships ON — it is a repair for a path that silently
# stops; set this to true to stop it without a deploy.
# ACTIVITY_MAIL_SYNC_DISABLED=false

# Phone escalation v0 (Optional — BYO Twilio, off by default)
# One plain TTS call when a PUSH-tier push goes unacknowledged. Opt-in
# per user on top of this global flag. Quiet hours ALWAYS suppress calls.
# Each call costs real money (~$0.02–0.06 depending on destination country).
# PHONE_ESCALATION_ENABLED=false
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""           # E.164, e.g. +15555550000
# PUBLIC_URL=""                   # public HTTPS base URL of THIS API — Twilio
#                                 # must reach $PUBLIC_URL/api/phone/gather
# PHONE_ESCALATION_DAILY_CAP=3    # hard per-user daily call cap
# PHONE_ESCALATION_TIMEOUT_MINUTES=5  # unacked minutes before dialing

# Slack (Optional)
SLACK_BOT_TOKEN=""
SLACK_WEBHOOK_URL=""
SLACK_SIGNING_SECRET=""

# Notion (Optional — coming soon)
# NOTION_API_KEY=""

# ─── Sign in with Apple (APPLE_LOGIN_ENABLED=true to turn the button on) ────
# Services ID (the OAuth client_id, e.g. ai.klorn.web), NOT the App ID.
APPLE_CLIENT_ID=
# Apple Developer team + the Sign in with Apple key.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 private key contents (literal \n for newlines is accepted).
APPLE_PRIVATE_KEY=
# Must match the Services ID's registered Return URL exactly.
APPLE_REDIRECT_URI=https://klorn-api.onrender.com/api/auth/apple/callback
APPLE_LOGIN_ENABLED=false
